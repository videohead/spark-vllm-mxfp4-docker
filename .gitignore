# Cache directories
.cache/

# Local runtime config (contains secrets such as HUGGING_FACE_HUB_TOKEN)
.env

# Model download virtualenv
.venv-download/

# Test logs (generated per run)
test_logs/

# Test output artifacts
# Note: Most harness outputs go under test_logs/ (already ignored above)
