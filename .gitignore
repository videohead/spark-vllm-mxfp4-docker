*.nsys-rep
*.qdrep
*.qdstrm
*.sqlite
*.nvvp

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
.venv/
venv/
ENV/

# IDE settings
.idea/
.vscode/
*.swp
*.swo
*~

# Benchmark results (local test runs)
results/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log.tmp
